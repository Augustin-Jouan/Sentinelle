{
  "name": "sentinelle-init",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run --project unit --passWithNoTests",
    "test:int": "vitest run --project integration --passWithNoTests",
    "test:e2e": "playwright test",
    "visuel:serveur": "dotenv -e .env.test -- sh -c 'export E2E=1 BETTER_AUTH_URL=http://localhost:3200 && node scripts/reinitialiser-base-test.mjs && tsx prisma/seed.ts && tsx e2e/admin-sans-provisoire.ts && tsx e2e/visuel/preparer-maquette.ts && next build && next start -p 3200'",
    "visuel:references": "playwright test -c playwright.visuel.config.ts --update-snapshots",
    "test:visuel": "playwright test -c playwright.visuel.config.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:demo": "tsx prisma/seed-demo.ts",
    "e2e:serveur": "dotenv -e .env.test -- sh -c 'export E2E=1 && node scripts/reinitialiser-base-test.mjs && tsx prisma/seed.ts && tsx e2e/admin-sans-provisoire.ts && tsx e2e/preparer-planning.ts && tsx e2e/preparer-financier.ts && tsx e2e/preparer-suivi.ts && next build && next start -p 3100'"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-auth": "^1.7.6",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "fflate": "0.8.3",
    "next": "^16.3.8",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "playwright": "^1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/spline-sans-mono": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.2"
  }
}
